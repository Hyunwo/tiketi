# Auth Service 환경 변수

# 서버 설정
PORT=3001
NODE_ENV=development

# 데이터베이스
DB_HOST=localhost
DB_PORT=5432
DB_NAME=tiketi
DB_USER=tiketi
DB_PASSWORD=tiketi123

# JWT 설정
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# CORS
